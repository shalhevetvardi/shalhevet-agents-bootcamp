# whatsapp-broadcaster-for-groups — Environment Variables
# העתיקי את הקובץ הזה ל-.env ומלאי את הערכים האמיתיים.
# הקובץ .env לעולם לא נכנס לגיט (ראי .gitignore).

# === Anthropic API ===
# מקור: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXX

# === Notion API ===
# מקור: https://www.notion.so/profile/integrations/internal
NOTION_API_KEY=ntn_XXXXX

# === Notion Database IDs ===
# WhatsApp Broadcasts (output) — created via Claude MCP under "אוטומציות ופלאגינים — תיעוד"
NOTION_DB_BROADCASTS_ID=
NOTION_DB_BROADCASTS_DATASOURCE_ID=

# Extractor input DB — populated when the Extractor pipeline is built (shared Hub)
NOTION_DB_EXTRACTOR_ID=

# === Model Selection (per PLAN.md) ===
ANTHROPIC_MODEL_ONBOARDING=claude-sonnet-4-5
ANTHROPIC_MODEL_WRITING=claude-opus-4-6
